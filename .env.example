# Copy this file to .env.local and fill in your own keys.
# Never commit .env.local. Only variable NAMES appear in code, never values.

# OpenRouter (free models): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=

# Google AI Studio (optional): https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Local Ollama (optional, no key needed)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Ledger database file location (used by the product, not required for prebuilt tests)
LEDGER_DB_PATH=./data/ledger.db
